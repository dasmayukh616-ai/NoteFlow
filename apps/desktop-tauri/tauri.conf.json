{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteFlow Desktop",
  "version": "0.1.0",
  "identifier": "com.noteflow.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../web-leptos/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NoteFlow Desktop",
        "width": 1280,
        "height": 840,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
